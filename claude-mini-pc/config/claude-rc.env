# Einstellungen für Claude Code Remote Control auf dem Mini-PC.
# Liegt nach der Einrichtung unter /etc/claude-rc.env (Bash-Syntax: NAME="wert").
# Nach Änderungen übernehmen mit: claude-rc restart

# Linux-Benutzer, unter dem Claude läuft (eigener Benutzer ohne Admin-Rechte).
CLAUDE_USER="claude"

# Arbeitsordner: Hier startet jede Session (enthält CLAUDE.md und SERVERS.md).
WORKSPACE="/home/claude/workspace"

# Dein Name – taucht in Claudes Arbeitsanweisungen und der Vertrauensliste auf.
OWNER=""

# Rechte-Modus neuer Sessions:
#   auto        Claude arbeitet selbstständig; ein Prüfmodell blockt Riskantes (empfohlen)
#   acceptEdits Dateiänderungen laufen automatisch, Befehle bestätigst du auf dem Handy
#   default     du bestätigst fast jede Aktion auf dem Handy
PERMISSION_MODE="auto"

# Wie Sessions arbeiten, die du in der App neu startest:
#   same-dir    alle im Arbeitsordner (einfach, empfohlen)
#   worktree    jede Session in einer eigenen Git-Worktree-Kopie (für parallele Aufgaben)
SPAWN_MODE="same-dir"

# Präfix für automatische Session-Namen in der App (leer = Hostname,
# z. B. „minipc-graceful-unicorn“).
SESSION_NAME_PREFIX=""

# Weitere Optionen für `claude remote-control`, durch Leerzeichen getrennt,
# z. B. "--capacity 4 --verbose".
EXTRA_ARGS=""
